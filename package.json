{
  "name": "branchwork",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:fast": "vitest run tests/db tests/claude tests/architecture.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench:sync": "tsx scripts/bench-sync.ts",
    "diagnose": "tsx scripts/diagnose.ts",
    "bw": "node --disable-warning=ExperimentalWarning --import tsx scripts/bw.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dev:web": "vite -c vite.renderer.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.3.0",
    "electron-vite": "^6.0.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^7.3.8",
    "vitest": "^3.0.0",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322"
  },
  "main": "out/main/index.js"
}
